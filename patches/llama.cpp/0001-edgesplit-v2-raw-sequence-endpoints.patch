+std::unique_ptr<server_res_generator> server_routes::handle_edgesplit_v2_export(const server_http_req & req, int id_slot) {
+    auto res = create_response();
+    auto & rd = res->rd;
+    {
+        server_task task(SERVER_TASK_TYPE_EDGESPLIT_V2_EXPORT);
+        task.id = rd.get_new_id();
+        task.edgesplit_v2_action.id_slot = id_slot;
+        rd.post_task(std::move(task));
+    }
+
+    auto result = rd.next(req.should_stop);
+    if (!result) {
+        GGML_ASSERT(req.should_stop());
+        return res;
+    }
+    if (result->is_error()) {
+        res->error(result->to_json());
+        return res;
+    }
+    auto * state = dynamic_cast<server_task_result_edgesplit_v2 *>(result.get());
+    GGML_ASSERT(state != nullptr && state->is_export);
+
+    const edgesplit_v2_state_header header = {
+        EDGESPLIT_V2_STATE_MAGIC,
+        EDGESPLIT_V2_STATE_VERSION,
+        state->id_slot,
+        (uint32_t) state->tokens.size(),
+        (uint64_t) state->state.size(),
+    };
+    std::string body;
+    body.reserve(sizeof(header) + state->tokens.size()*sizeof(llama_token) + state->state.size());
+    body.append(reinterpret_cast<const char *>(&header), sizeof(header));
+    if (!state->tokens.empty()) {
+        body.append(reinterpret_cast<const char *>(state->tokens.data()), state->tokens.size()*sizeof(llama_token));
+    }
+    body.append(reinterpret_cast<const char *>(state->state.data()), state->state.size());
+    res->content_type = "application/octet-stream";
+    res->headers["X-EdgeSplit-V2-State-Version"] = std::to_string(EDGESPLIT_V2_STATE_VERSION);
+    res->headers["X-EdgeSplit-V2-Sequence-Length"] = std::to_string(state->tokens.size());
+    res->data = std::move(body);
+    return res;
+}
+
+std::unique_ptr<server_res_generator> server_routes::handle_edgesplit_v2_import(const server_http_req & req, int id_slot) {
+    auto res = create_response();
+    if (req.body.size() < sizeof(edgesplit_v2_state_header)) {
+        res->error(format_error_response("EdgeSplit V2 state body is too small", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+    edgesplit_v2_state_header header;
+    std::memcpy(&header, req.body.data(), sizeof(header));
+    if (header.magic != EDGESPLIT_V2_STATE_MAGIC || header.version != EDGESPLIT_V2_STATE_VERSION) {
+        res->error(format_error_response("Invalid EdgeSplit V2 state header", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+    if (header.n_tokens > SIZE_MAX / sizeof(llama_token) || header.state_bytes > SIZE_MAX) {
+        res->error(format_error_response("Invalid EdgeSplit V2 state lengths", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+    const size_t tokens_bytes = (size_t) header.n_tokens * sizeof(llama_token);
+    const size_t state_bytes = (size_t) header.state_bytes;
+    if (tokens_bytes > SIZE_MAX - sizeof(header) ||
+            state_bytes > SIZE_MAX - sizeof(header) - tokens_bytes ||
+            req.body.size() != sizeof(header) + tokens_bytes + state_bytes) {
+        res->error(format_error_response("Invalid EdgeSplit V2 state body length", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    server_task task(SERVER_TASK_TYPE_EDGESPLIT_V2_IMPORT);
+    task.id = res->rd.get_new_id();
+    task.edgesplit_v2_action.id_slot = id_slot;
+    const char * cursor = req.body.data() + sizeof(header);
+    task.edgesplit_v2_action.tokens.resize(header.n_tokens);
+    if (tokens_bytes > 0) {
+        std::memcpy(task.edgesplit_v2_action.tokens.data(), cursor, tokens_bytes);
+        cursor += tokens_bytes;
+    }
+    task.edgesplit_v2_action.state.resize(state_bytes);
+    std::memcpy(task.edgesplit_v2_action.state.data(), cursor, state_bytes);
+    res->rd.post_task(std::move(task));
+
+    auto result = res->rd.next(req.should_stop);
+    if (!result) {
+        GGML_ASSERT(req.should_stop());
+        return res;
+    }
+    if (result->is_error()) {
+        res->error(result->to_json());
+        return res;
+    }
+    res->ok(result->to_json());
+    return res;
+}
 
